# Prebuilt protoc instead of building protobuf's C++ from source (~1100
# CppCompile actions before any of our own code compiles). Both codegen paths
# (rules_go, rules_rust_prost) pick it up via proto toolchain resolution, which
# is the default as of Bazel 9.
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

test --test_output=errors
