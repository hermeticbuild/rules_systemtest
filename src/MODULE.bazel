module(
    name = "rules_systemtest_src",
    version = "0.0.0",
)

# The build-from-source module.
#
# `rules_systemtest` will ship precompiled binaries to keep its deps minimal.
#
# Consumers who want the services built from source will add:
#
#   bazel_dep(name = "rules_systemtest_src", version = "<same as ruleset>")
#   register_toolchains("@rules_systemtest_src//toolchains:all")
#
# ==========================================================================

bazel_dep(name = "rules_systemtest", version = "0.0.0")
local_path_override(
    module_name = "rules_systemtest",
    path = "..",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_rust_prost", version = "0.73.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.6")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_google_uuid",
    "com_github_spf13_cobra",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Our own prost/tonic codegen toolchain. See docs there for why it's needed.
register_toolchains("//toolchains:prost_toolchain")

# Third-party crates.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = [
        "//:Cargo.toml",
        "//coordinator:Cargo.toml",
        "//plugins/dummy:Cargo.toml",
        "//proto/codegen:Cargo.toml",
        "//proto/systemtestrs:Cargo.toml",
    ],
)
use_repo(crate, "crates")
