load("@crates//:defs.bzl", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "coordinator",
    srcs = [
        "src/coordinator.rs",
        "src/fixture.rs",
        "src/lease.rs",
        "src/lib.rs",
        "src/plugin_client.rs",
    ],
    edition = crate_edition(),
    deps = all_crate_deps(normal = True) + [
        "//proto:systemtest_rust_proto",
    ],
)

rust_binary(
    name = "coordinator_local",
    srcs = ["src/bin/coordinator_local.rs"],
    edition = crate_edition(),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        ":coordinator",
        "//proto:systemtest_rust_proto",
    ],
)

# Referenced by crate.from_cargo(manifests = ...) in //:MODULE.bazel.
exports_files(["Cargo.toml"])
