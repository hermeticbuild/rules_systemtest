load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

package_metadata(
    name = "package_metadata",
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

alias(
    name = "gazelle",
    actual = "//tools:gazelle",
)

# The public API is //systemtest:defs.bzl; see //systemtest/BUILD.bazel for its
# bzl_library.

# //:coordinator_mode — only "local" is wired in the scaffold.
string_flag(
    name = "coordinator_mode",
    build_setting_default = "local",
    values = [
        "local",
        "remote",
    ],
    visibility = ["//visibility:public"],
)
